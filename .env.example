# Espressly — environment
#
# Copy to `.env.local` and adjust. Never commit real secrets: only variables
# prefixed with NEXT_PUBLIC_ are exposed to the browser, and this project has
# none that need to be.

# Canonical origin used for canonical tags, Open Graph URLs, the sitemap and
# every piece of JSON-LD. Must be a valid absolute URL.
NEXT_PUBLIC_SITE_URL=https://www.espressly.coffee

# --- Verified business details -------------------------------------------
# These live in src/config/site.ts so they can be read from both server and
# client components. Fill in the real values before launch; the phone number
# currently in config is intentionally from the reserved 555 range.
#
#   contact.email
#   contact.phone / contact.phoneHref
#   contact.address (street, locality, region, postalCode, country)
#   contact.coordinates
#   socialLinks (navigation.ts)
#
# --- Newsletter + contact form -------------------------------------------
# Both forms are front-end only right now. Wire them to your provider of choice
# in src/components/ui/newsletter-form.tsx and
# src/components/contact/contact-form.tsx. Never put an API key here — anything
# in this file ships to the browser.